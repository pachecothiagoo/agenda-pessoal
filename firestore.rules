rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados em users/{uid}/events só podem ser acessados pelo próprio usuário.
    match /users/{userId}/events/{eventId} {
      function ownsUserData() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validBaseFields(data) {
        return data.keys().hasOnly([
          'title', 'date', 'time', 'duration', 'category', 'notes',
          'done', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.done is bool
        && (!('duration' in data) || (data.duration is int && data.duration >= 15 && data.duration <= 480))
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && data.updatedAt is timestamp;
      }

      allow read, delete: if ownsUserData();
      allow create: if ownsUserData()
        && validBaseFields(request.resource.data)
        && request.resource.data.done == false
        && request.resource.data.createdAt is timestamp;
      allow update: if ownsUserData()
        && validBaseFields(request.resource.data);
    }
  }
}
