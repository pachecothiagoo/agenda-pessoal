rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados em users/{uid}/events só podem ser acessados pelo próprio usuário.
    match /users/{userId}/events/{eventId} {
      function ownsUserData() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validBaseFields(data) {
        return data.keys().hasOnly([
          'title', 'date', 'time', 'duration', 'category', 'notes',
          'done', 'createdAt', 'updatedAt', 'reminderMinutes', 'eventAt',
          'reminderAt', 'reminderSentAt', 'reminderClaimedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.done is bool
        && (!('duration' in data) || (data.duration is int && data.duration >= 15 && data.duration <= 480))
        && (!('category' in data) || (data.category is string && data.category.size() <= 40))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('reminderMinutes' in data) || data.reminderMinutes in [0, 5, 10, 15, 30, 60, 1440])
        && (!('eventAt' in data) || data.eventAt is timestamp)
        && (!('reminderAt' in data) || data.reminderAt is timestamp)
        && (!('reminderSentAt' in data) || data.reminderSentAt == null || data.reminderSentAt is timestamp)
        && (!('reminderClaimedAt' in data) || data.reminderClaimedAt == null || data.reminderClaimedAt is timestamp)
        && data.updatedAt is timestamp;
      }

      allow read, delete: if ownsUserData();
      allow create: if ownsUserData()
        && validBaseFields(request.resource.data)
        && request.resource.data.done == false
        && request.resource.data.createdAt is timestamp;
      allow update: if ownsUserData()
        && validBaseFields(request.resource.data);
    }

    // Assinaturas Web Push pertencem apenas ao usuário autenticado.
    match /users/{userId}/devices/{deviceId} {
      function ownsUserData() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validDevice(data) {
        return data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'platform', 'updatedAt'])
          && data.keys().hasAll(['endpoint', 'p256dh', 'auth', 'updatedAt'])
          && data.endpoint is string
          && data.endpoint.size() > 0
          && data.endpoint.size() <= 2048
          && data.p256dh is string
          && data.p256dh.size() > 0
          && data.p256dh.size() <= 256
          && data.auth is string
          && data.auth.size() > 0
          && data.auth.size() <= 256
          && (!('platform' in data) || (data.platform is string && data.platform.size() <= 200))
          && data.updatedAt is timestamp;
      }
      allow read, delete: if ownsUserData();
      allow create, update: if ownsUserData() && validDevice(request.resource.data);
    }
  }
}
